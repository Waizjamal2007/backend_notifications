{
  "rules": {
    ".read": false,
    ".write": false,
    "books": {
      ".read": true,
      ".write": false,
      "$id": {
        ".validate": "newData.hasChildren(['title','author','genre','price','stock','year','rating'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        }
      }
    },
    "users": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('disabled').val() !== true && newData.exists()",
        ".validate": "newData.hasChildren(['name','email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "shippingAddress": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "paymentMethod": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "disabled": {
          ".validate": "newData.val() === data.val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "carts": {
      "$uid": {
        ".read": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        "$bookId": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100 && newData.val() % 1 === 0"
        }
      }
    },
    "wishlists": {
      "$uid": {
        ".read": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        "$bookId": {
          ".validate": "newData.val() === true"
        }
      }
    },
    "orders": {
      ".indexOn": [
        "userId",
        "createdAt"
      ],
      ".read": "(auth != null && auth.token.admin === true) || ((auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && query.orderByChild === 'userId' && query.equalTo === auth.uid)",
      "$orderId": {
        ".read": "(auth != null && auth.token.admin === true) || ((auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && data.child('userId').val() === auth.uid)",
        "status": {
          ".write": false,
          ".validate": "newData.val() === 'Placed' || newData.val() === 'Processing' || newData.val() === 'Dispatched' || newData.val() === 'Delivered'"
        },
        "updatedAt": {
          ".write": false,
          ".validate": "newData.isNumber()"
        }
      }
    },
    "deviceTokens": {
      "$uid": {
        ".read": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid"
      }
    },
    "announcements": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ]
    },
    "notifications": {
      "$uid": {
        ".read": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && auth.uid === $uid",
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "reviews": {
      ".read": true,
      "$bookId": {
        "$reviewId": {
          ".write": "((auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && !data.exists() && newData.child('userId').val() === auth.uid) || (((auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && data.child('userId').val() === auth.uid) && !newData.exists()) || (auth != null && auth.token.admin === true)",
          ".validate": "newData.hasChildren(['userId','name','rating','text','likes','createdAt'])",
          "userId": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "rating": {
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && data.parent().child('userId').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "text": {
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && data.parent().child('userId').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
          },
          "updatedAt": {
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('disabled').val() !== true) && data.parent().child('userId').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "likes": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 0) || newData.val() === data.val())"
          },
          "likedBy": {
            ".validate": "data.exists()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pushQueue": {
      ".indexOn": [
        "sentAt"
      ]
    }
  }
}
